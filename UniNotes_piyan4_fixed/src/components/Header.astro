---
import { url } from '../lib/site';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首頁' },
  { href: '/categories/', label: '分類' },
  { href: '/search/', label: '搜尋' },
  { href: '/about/', label: '關於' },
];
const isActive = (href: string) => (href === '/' ? path === url('/') || path === url('') : path.startsWith(url(href)));
---
<header class="site-header">
  <div class="container">
    <a class="logo" href={url('/')}>Uni<span>Notes</span></a>
    <nav class="nav" aria-label="主選單">
      {links.map((l) => <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
  </div>
</header>
